# Copy to .env next to the repository root. The backend reads it at startup.

# ---------- local models ----------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b

# Any OpenAI-compatible server: LM Studio (port 1234), llama.cpp (8080), vLLM (8000)
CUSTOM_LLM_URL=http://127.0.0.1:1234/v1
# CUSTOM_LLM_KEY=
# CUSTOM_LLM_MODEL=

# ---------- speech recognition ----------
# Multilingual whisper model from Hugging Face; the first run downloads it into .cache/transformers
WHISPER_MODEL=Xenova/whisper-small
# Language of the dialogue; the UI can override it per transcription
WHISPER_LANGUAGE=ru

# ---------- cloud providers (fill in the ones you use) ----------
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# ---------- backend ----------
# PORT=8787

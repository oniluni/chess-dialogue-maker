# Copy to .env and adjust. Every value here is optional.

# ---------- LLM ----------
# provider: ollama | pollinations (no key) | github | groq | openrouter | mistral | gemini
# default only: the web UI switches provider/model at runtime and saves keys you paste there into this file
LLM_PROVIDER=ollama
# LLM_MODEL=                 # model for LLM_PROVIDER (the UI writes both here when you pick them)
# GROQ_API_KEY=              # https://console.groq.com/keys
# OPENROUTER_API_KEY=        # https://openrouter.ai/settings/keys  (":free" models cost nothing)
# MISTRAL_API_KEY=           # https://console.mistral.ai/api-keys
# GITHUB_TOKEN=              # GitHub Models: fine-grained token with "Models: read"
OLLAMA_URL=http://localhost:11434
# a general model writes much better Russian than qwen2.5-coder: qwen3.5:9b (~16 GB RAM),
# gemma4:12b, on a strong PC gemma4:26b / qwen3.8:27b; if it is not pulled, the best installed one is used
OLLAMA_MODEL=qwen3.5:9b
# GEMINI_API_KEY=            # https://aistudio.google.com/apikey
# ANTHROPIC_API_KEY=         # https://console.anthropic.com/settings/keys  (Claude API — платно; подписка Pro/Max ключа API не даёт)
# GEMINI_MODEL=gemini-3.8-flash
LLM_LANGUAGE=русском
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.4
EVAL_GAIN=1.5                # how strongly the eval reacts to each move (1.0 = as the LLM said)

# ---------- who speaks (faces + voices -> hints for the LLM) ----------
DIARIZATION=true             # false = no speaker hints (the LLM guesses alone)
VISION_FPS=10                # face-detection samples per second
# SPEAKER_HINT_MIN_CONF=0.6  # weaker hints are shown to the LLM as "голос ?"

# ---------- faster-whisper ----------
WHISPER_MODEL=small          # tiny | base | small | medium | large-v3
WHISPER_DEVICE=auto          # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=int8    # int8 on CPU, float16 on GPU
# WHISPER_LANGUAGE=ru        # empty = autodetect

# ---------- source cache ----------
# SOURCE_CACHE=true          # keep downloads in jobs/_sources and reuse them for new jobs / new cuts
# Only the selected fragment (+3 s) is downloaded. The whole video only when you ask for it
# (or when no fragment is selected; for videos longer than this you are asked first):
# FULL_DOWNLOAD_ASK=900      # s

# ---------- yt-dlp ----------
# If YouTube says "Sign in to confirm you're not a bot" (or a video is only available to your account),
# yt-dlp can use your own session — set it in the UI («Доступ к YouTube») or here:
# YTDLP_COOKIES_FROM_BROWSER=firefox
# YTDLP_COOKIES=/path/to/youtube_cookies.txt
# YTDLP_BIN=/path/to/yt-dlp  # another yt-dlp build (default: the one in .venv; «Обновить yt-dlp» updates it)

# ---------- video ----------
FPS=30                       # 30 or 60
OUTPUT_FORMAT=tiktok         # tiktok = 1080x1920 | original = source aspect under the UI | landscape = 1920x1080
VIDEO_MODE=smart             # smart = face-aware reframing per shot (blurred background when needed)
                             # fill = static centre crop under the eval bar, crop = fixed VIDEO_CROP_ASPECT
                             # window, fit = whole frame, letterboxed
VIDEO_CROP_ASPECT=1.2        # width/height of the window in crop mode (1.2 ≈ reference, 1.0 = square)
VIDEO_ANCHOR_Y=0.3           # fill/crop: which part survives vertical cropping: 0 = top, 0.5 = centre
X264_CRF=18
X264_PRESET=medium

# ---------- pause on move + sound effects ----------
# (defaults only: the web UI changes these per video and remembers your last choice in .ui_prefs.json)
PAUSE_ON_MOVE=true           # freeze the video while each move is explained (typewriter text)
TYPING_CPS=28                # typewriter speed, characters per second
READ_HOLD=2.0                # s the typed text stays on screen before the video resumes
SFX_ENABLED=true             # all sounds on/off (assets/sfx, generated by make_assets.py)
SFX_VOLUME=0.8               # 0..1
SFX_PAUSE=true               # individual sounds
SFX_UNPAUSE=true
SFX_TYPING=true
SFX_TYPING_SET=soft          # soft | typewriter | mechanical | pencil | bubble (or a folder of type_tick_*.wav in assets/sfx/typing)
SFX_PAUSE_SET=wood           # wood | clock | whoosh | chime | tape (or a folder with pause.wav + unpause.wav in assets/sfx/pause)

# ---------- TikTok ----------
TIKTOK_COOKIES=cookies.txt   # Netscape format, exported while logged in to tiktok.com
TIKTOK_BROWSER=chromium      # chromium (playwright) | chrome (needs Google Chrome) | firefox
TIKTOK_HEADLESS=false        # headful is less likely to trip TikTok's bot checks

# JOBS_DIR=./jobs
